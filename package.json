{
  "name": "study-forge",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch --env-file=.env server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "node dist/index.js",
    "check": "tsc",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "docker:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build",
    "docker:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml -f docker-compose.prod.yml down",
    "docker:logs": "docker compose logs -f app",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "migrate": "tsx --env-file=.env server/migrations/run-migration.ts",
    "migrate:security": "tsx --env-file=.env server/db/migrations/run-migration.ts",
    "migrate:security:rollback": "tsx --env-file=.env server/db/migrations/run-migration.ts --rollback",
    "create-admin": "tsx --env-file=.env scripts/create-admin.ts",
    "test:e2e": "tsx --env-file=.env tests/e2e/auth.e2e.test.ts",
    "postinstall": "npm run check"
  },
