# ============================================
# StudyForge - Environment Configuration
# ============================================
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control!

# ============================================
# DATABASE CONFIGURATION (Required)
# ============================================
# PostgreSQL database connection settings
# Standard connection string format: postgres://user:password@host:port/database

# Local development URL
DATABASE_URL=postgres://postgres:password@localhost:5432/studyforge

# For production (e.g., Neon), use the URL provided by the service:
# DATABASE_URL=postgres://user:password@ep-cool-db.neon.tech/dbname?sslmode=require


# ============================================
# JWT CONFIGURATION (Required for Authentication)
# ============================================
# Secret key for signing JWT tokens
# IMPORTANT: Must be at least 32 characters long for security
# Generate a secure secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long-please-change-this

# JWT token expiry times
# Access tokens are short-lived for security
JWT_ACCESS_EXPIRY=15m
# Refresh tokens allow users to stay logged in longer
JWT_REFRESH_EXPIRY=7d


# ============================================
# EMAIL SERVICE CONFIGURATION (Optional but Recommended)
# ============================================
# SMTP configuration for sending transactional emails
# Required for authentication features:
#   - Email verification during registration
#   - Password reset functionality
#   - Account security notifications

# SMTP server settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Set to true for port 465, false for other ports
SMTP_SECURE=false

# SMTP authentication credentials
# For Gmail: Use an App Password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Email sender information
SMTP_FROM_NAME=StudyForge
SMTP_FROM_EMAIL=noreply@studyforge.com

# Admin email for receiving contact form notifications
ADMIN_EMAIL=admin@studyforge.com


# ============================================
# GEMINI AI CONFIGURATION (Required)
# ============================================
# Google Gemini API key for AI-powered features
# Required for: chat, code generation, flashcard generation, document summarization
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here


# ============================================
# CODE EXECUTION CONFIGURATION (Optional)
# ============================================
# JDoodle API for online code execution
# Required for running code in the Code Generator feature
# Get your credentials from: https://www.jdoodle.com/compiler-api
# Free tier: 200 requests per day
JDOODLE_CLIENT_ID=your-jdoodle-client-id
JDOODLE_CLIENT_SECRET=your-jdoodle-client-secret


# ============================================
# CLOUDINARY CONFIGURATION (Optional but Recommended)
# ============================================
# Cloudinary is used for image storage and optimization
# Get your credentials from: https://cloudinary.com/console
# If not configured, images will be stored as base64 in database

# IMPORTANT: Replace with YOUR actual cloud name from dashboard (usually lowercase)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Folder name for organizing uploads
CLOUDINARY_FOLDER=


# ============================================
# FILE UPLOAD CONFIGURATION (Optional)
# ============================================
# Maximum file sizes in MB
MAX_FILE_SIZE_MB=10
MAX_IMAGE_SIZE_MB=5

# Upload rate limiting
UPLOAD_RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
UPLOAD_RATE_LIMIT_MAX_FILES=20      # 20 files per window

# Skip upload rate limiting in development (set to true to disable)
SKIP_UPLOAD_RATE_LIMIT=false


# ============================================
# VIRUS SCANNING CONFIGURATION (Optional but Recommended for Production)
# ============================================
# Enable virus scanning for uploaded files
# Requires ClamAV daemon to be running
# Install ClamAV: https://www.clamav.net/downloads
ENABLE_VIRUS_SCAN=false

# ClamAV daemon settings
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Strict mode: reject files if scan fails (recommended for production)
VIRUS_SCAN_STRICT=false


# ============================================
# OPENAI CONFIGURATION (Optional)
# ============================================
# OpenAI API key for additional AI features
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-api-key-here


# ============================================
# SESSION CONFIGURATION (Optional)
# ============================================
# Secret key for session management
# Generate a secure secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-session-secret-key-change-in-production


# ============================================
# REDIS CONFIGURATION (Optional)
# ============================================
# Redis is used for caching AI responses and rate limiting
# If not configured, in-memory caching will be used
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=


# ============================================
# QUIZ CACHE CONFIGURATION (Optional)
# ============================================
# In-memory cache for AI-generated quiz questions
# Reduces redundant AI API calls for identical quiz configurations

# Time-to-live for cache entries in milliseconds (default: 3600000 = 1 hour)
QUIZ_CACHE_TTL_MS=3600000

# Maximum number of cache entries (default: 1000)
# When exceeded, least recently used entries are evicted (LRU)
QUIZ_CACHE_MAX_SIZE=1000


# ============================================
# SERVER CONFIGURATION (Optional)
# ============================================
# Port for the API server
API_PORT=5000

# Node environment (development, production, test)
NODE_ENV=development

# Application URLs
# Used for generating links in emails and CORS configuration
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5000


# ============================================
# SECURITY CONFIGURATION (Optional)
# ============================================
# Password hashing configuration
# Higher rounds = more secure but slower (recommended: 12)
BCRYPT_ROUNDS=12

# Token expiry times (in hours)
# Verification tokens for email verification
TOKEN_EXPIRY_HOURS_VERIFICATION=24
# Reset tokens for password reset
TOKEN_EXPIRY_HOURS_RESET=1

# Rate limiting configuration
# Window size in milliseconds (default: 15 minutes = 900000ms)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per window (default: 5)
RATE_LIMIT_MAX_REQUESTS=5

# Account lockout configuration
# Number of failed login attempts before account lockout
MAX_FAILED_LOGIN_ATTEMPTS=10
# Account lockout duration in minutes
ACCOUNT_LOCKOUT_DURATION_MINUTES=60


# ============================================
# CORS CONFIGURATION (Required for Production)
# ============================================
# Comma-separated list of allowed origins for CORS
# In production, set this to your frontend domain(s)
# In development, localhost origins are automatically allowed
# Example: CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=


# ============================================
# LOGGING CONFIGURATION (Optional)
# ============================================
# Log level (error, warn, info, debug)
# LOG_LEVEL=info
# Log file path (if not set, logs to console only)
# LOG_FILE_PATH=./logs/app.log
