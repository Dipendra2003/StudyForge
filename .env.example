# ============================================
# Jadoo Study Assistant - Environment Configuration
# ============================================

# ============================================
# DATABASE CONFIGURATION (Required)
# ============================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=StudyForge


# ============================================
# JWT CONFIGURATION (Required)
# ============================================
# Generate secure random secrets with:
# openssl rand -base64 32
# or
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# IMPORTANT: Use different secrets for access and refresh tokens
# Keep these secrets secure and never commit them to version control

# JWT Access Token Secret (minimum 32 characters)
JWT_ACCESS_SECRET=your-access-token-secret-min-32-chars

# JWT Refresh Token Secret (minimum 32 characters)
JWT_REFRESH_SECRET=your-refresh-token-secret-min-32-chars


# ============================================
# EMAIL SERVICE CONFIGURATION (Required for production)
# ============================================
# Gmail SMTP Configuration
# To use Gmail, you need to:
# 1. Enable 2-Factor Authentication on your Google account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use the App Password (not your regular Gmail password)
#
# Required for:
# - Email verification
# - Password reset emails
# - Welcome emails
# - Password change notifications

# Your Gmail address
GMAIL_USER=your-email@gmail.com

# Gmail App Password (16-character password from Google)
# NOT your regular Gmail password!
# Get yours at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your-16-char-app-password

# Application URL (used in email links)
# Development: http://localhost:5000
# Production: https://your-domain.com
APP_URL=http://localhost:5000

# From email address for outgoing emails (optional)
# If not set, will use GMAIL_USER
# Format: "Name <email@domain.com>"
FROM_EMAIL=Jadoo <your-email@gmail.com>


# ============================================
# OPENAI CONFIGURATION (Required)
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key


# ============================================
# REDIS CONFIGURATION (Optional)
# ============================================
# Redis is used for caching AI responses
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=


# ============================================
# SERVER CONFIGURATION (Optional)
# ============================================
API_PORT=5000
NODE_ENV=development
